-endif
+" Neovim 0.5+ dropped cscope support, but this module only uses it for the
+" optional `cs add` integration. gutentags_plus runs gtags-cscope directly,
+" so the guard below is removed to allow GTAGS generation on modern Neovim.
 
 " Global Options {{{
 
@@ -62,7 +61,9 @@ function! gutentags#gtags_cscope#init(project_root) abort
 
     let b:gutentags_files['gtags_cscope'] = l:db_file
 
-    execute 'set cscopeprg=' . fnameescape(g:gutentags_gtags_cscope_executable)
+    if has('cscope')
+        execute 'set cscopeprg=' . fnameescape(g:gutentags_gtags_cscope_executable)
+    endif
 
     " The combination of gtags-cscope, vim's cscope and global files is
     " a bit flaky. Environment variables are safer than vim passing
