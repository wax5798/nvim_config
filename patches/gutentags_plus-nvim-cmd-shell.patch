+"----------------------------------------------------------------------
+" run a shell command through cmd.exe
+"
+" Neovim on win32 dispatches string commands via &shell. When that shell
+" is a bash-like one (MSYS2 / Git for Windows) nvim still appends /s /c,
+" which bash cannot parse, so every system()/jobstart() string call fails
+" with "/usr/bin/bash: /s: No such file or directory". Route the cmd.exe
+" style commands (cd /d, *.cmd runners) through cmd.exe instead.
+"----------------------------------------------------------------------
+function! s:run_win32(cmd, list)
+	if (has('win32') || has('win64')) && &shell !~# 'cmd\.exe$'
+		let l:old_shell = &shell
+		let l:old_shellcmdflag = &shellcmdflag
+		let &shell = 'cmd.exe'
+		let &shellcmdflag = '/s /c'
+	endif
+	try
+		if a:list
+			return systemlist(a:cmd)
+		else
+			return system(a:cmd)
+		endif
+	finally
+		if exists('l:old_shell')
+			let &shell = l:old_shell
+			let &shellcmdflag = l:old_shellcmdflag
+		endif
+	endtry
+endfunc
+
 
